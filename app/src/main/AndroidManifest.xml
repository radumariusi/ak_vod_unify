<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Calendar: notificarea de dimineață și canalul „Azi apare” de pe ecranul principal TV. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        AK Scrobbler trimite aici ce redă televizorul. Permisiunea e „signature”: o primesc doar
        aplicațiile semnate cu aceeași cheie. E definită și în AK Scrobbler (aceeași cheie), ca
        să meargă indiferent care aplicație se instalează prima.
    -->
    <permission
        android:name="${applicationId}.permission.SCROBBLE"
        android:label="Trimite redarea către AK VOD Unify"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.SCROBBLE" />

    <!-- Rulează atât pe Android TV (fără touchscreen) cât și pe telefoane. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Alege unde vezi: aplicațiile-țintă trebuie să fie vizibile (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="stremio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nuvio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- Căutare în aplicație (AK VoD Hub, playere IPTV). -->
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <!-- Detectare după nume pentru build-uri neoficiale (ex. DebridStream). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.amazon.firebat" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.amazon.avod" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
        <package android:name="com.nuvio.tv" />
        <package android:name="com.nuvio.app" />
        <package android:name="com.stremio.one" />
        <package android:name="com.debridstream.tv" />
        <package android:name="com.debridstream.app" />
        <package android:name="com.debridstream" />
        <!-- AK Scrobbler (aplicația însoțitoare). -->
        <package android:name="ro.ak.vodscrobbler" />
        <package android:name="ro.ak.vodscrobbler.debug" />
    </queries>

    <application
        android:name=".VodUnifyApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VodUnify">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".core.imports.ServiceHistoryActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".core.update.InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name=".core.scrobble.ScrobbleProvider"
            android:authorities="${applicationId}.scrobble"
            android:exported="true"
            android:permission="${applicationId}.permission.SCROBBLE" />

    </application>
</manifest>
